rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return (isAuthenticated() && request.auth.uid == userId) || userId == 'local_user';
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.email == "adrien.brunelliere@gmail.com" && request.auth.token.email_verified == true)
      );
    }
    
    function isBecomingAdmin() {
      return request.resource.data.get('role', '') == 'admin';
    }
    
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUser(data) {
      return (
        (!('userName' in data) || (data.userName is string && data.userName.size() < 100)) &&
        (!('firstName' in data) || (data.firstName is string && data.firstName.size() < 100)) &&
        (!('lastName' in data) || (data.lastName is string && data.lastName.size() < 100)) &&
        (!('companyName' in data) || (data.companyName is string && data.companyName.size() < 200)) &&
        (!('jobTitle' in data) || (data.jobTitle is string && data.jobTitle.size() < 100)) &&
        (!('onboarded' in data) || (data.onboarded is bool)) &&
        (!('roles' in data) || (data.roles is list)) &&
        (!('primaryRole' in data) || (data.primaryRole is string)) &&
        (!('status' in data) || (data.status is string)) &&
        (!('notifications' in data) || (data.notifications is list)) &&
        (!('email' in data) || (data.email is string))
      );
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data) && (!isBecomingAdmin() || isAdmin());
      allow delete: if isOwner(userId);
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /shifts/{shiftId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }
  }
}
